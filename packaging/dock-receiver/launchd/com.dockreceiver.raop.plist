<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dockreceiver.raop</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/dock-receiver/dock-raop</string>
	</array>
	<key>UserName</key>
	<string>mobile</string>
	<key>WorkingDirectory</key>
	<string>/var/mobile/dockreceiver</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>3</integer>
	<key>StandardOutPath</key>
	<string>/var/mobile/dockreceiver/logs/raop.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/dockreceiver/logs/raop.log</string>
</dict>
</plist>
