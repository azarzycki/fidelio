<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- B1.15 A: SpringBoard checks these before honouring a launch / away-view-plugin request. Without
	     them SBSLaunchApplicationWithIdentifier returns 1 ("SpringBoard is not running" in the error
	     table, but really "the caller is not entitled") even unlocked and as root, and SpringBoard
	     silently ignores SBEnableLockScreenBundle. fidelio-audiod (wake-on-play + lock plugin) and
	     fidelio-lockctl are signed with these via `armv6-ios3-ldid -S<this file>`. Present on both the
	     3.1.3 and the 5.1.1 SpringBoard binaries. -->
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.springboard.activateawayviewplugins</key>
	<true/>
	<!-- B1.16.4: SBSOpenSensitiveURLAndUnlock (unlock-on-play). The device proof on the iPad was made with
	     com.apple.springboard.openurlswhenlocked as well; this set leaves it out until a device test shows
	     it is needed (tools/build-arm.sh also produces a fidelio-audiod signed with it, for that test). -->
	<key>com.apple.springboard.opensensitiveurl</key>
	<true/>
</dict>
</plist>
