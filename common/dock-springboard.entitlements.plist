<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- B1.15 A: SpringBoard checks these before honouring a launch / away-view-plugin request. Without
	     them SBSLaunchApplicationWithIdentifier returns 1 ("SpringBoard is not running" in the error
	     table, but really "the caller is not entitled") even unlocked and as root, and SpringBoard
	     silently ignores SBEnableLockScreenBundle. dock-audiod (wake-on-play + lock plugin) and
	     dock-lockctl are signed with these via `armv6-ios3-ldid -S<this file>`. Present on both the
	     3.1.3 and the 5.1.1 SpringBoard binaries. -->
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.springboard.activateawayviewplugins</key>
	<true/>
	<!-- B1.16.4: SBSOpenSensitiveURLAndUnlock (unlock-on-play). -->
	<key>com.apple.springboard.opensensitiveurl</key>
	<true/>
	<!-- B1.16.6: needed as well to open an app's own URL scheme on a LOCKED device. Device A/B on the
	     5.1.1 iPad: SBSOpenSensitiveURLAndUnlock(nowplaying:, unlock) returns false without it and true
	     with it, from audiod and from an entitled cycript, as root and as mobile. With it, the iPad
	     unlocks into NowPlaying. prefs: (a system URL) opens with opensensitiveurl alone, which is why
	     an earlier test missed it. Untested on the 3.1.3 phone; a key its SpringBoard never checks is
	     simply ignored. -->
	<key>com.apple.springboard.openurlswhenlocked</key>
	<true/>
</dict>
</plist>
