From e72a3f29b6426e113cb8b40746ce69290be66db5 Mon Sep 17 00:00:00 2001
From: armv6-ios3 <b@b>
Date: Sat, 7 Nov 2026 04:38:44 +0000
Subject: [PATCH 4/4] armv6-ios3: expose last AP address (Session) and
 negotiated TLS suite (TLSSocket) for the status display

---
 bell/main/io/TLSSocket.cpp       | 13 +++++++++++++
 bell/main/io/include/TLSSocket.h |  5 +++++
 include/Session.h                |  2 ++
 src/Session.cpp                  |  1 +
 4 files changed, 21 insertions(+)

diff --git a/bell/main/io/TLSSocket.cpp b/bell/main/io/TLSSocket.cpp
index 489748d..1e8ddc7 100644
--- a/bell/main/io/TLSSocket.cpp
+++ b/bell/main/io/TLSSocket.cpp
@@ -13,6 +13,10 @@
 /**
  * Platform TLSSocket implementation for the mbedtls
  */
+#include <mutex>
+static std::mutex s_negotiatedMutex;
+static std::string s_negotiated;
+
 bell::TLSSocket::TLSSocket() {
   this->isClosed = false;
   mbedtls_net_init(&server_fd);
@@ -75,6 +79,15 @@ void bell::TLSSocket::open(const std::string& hostUrl, uint16_t port) {
       throw std::runtime_error("mbedtls_ssl_handshake error");
     }
   }
+  {
+    std::lock_guard<std::mutex> lock(s_negotiatedMutex);
+    s_negotiated = std::string(mbedtls_ssl_get_version(&ssl)) + " " + mbedtls_ssl_get_ciphersuite(&ssl);
+  }
+}
+
+std::string bell::TLSSocket::lastNegotiated() {
+  std::lock_guard<std::mutex> lock(s_negotiatedMutex);
+  return s_negotiated;
 }
 
 size_t bell::TLSSocket::read(uint8_t* buf, size_t len) {
