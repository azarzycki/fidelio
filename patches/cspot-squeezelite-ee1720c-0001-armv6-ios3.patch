From 5100cf81f86f21c77910047753bb57f7224e399c Mon Sep 17 00:00:00 2001
From: armv6-ios3 <b@b>
Date: Fri, 6 Nov 2026 06:38:34 +0000
Subject: [PATCH 1/4] armv6-ios3: build on iPhone OS 3 (no libdispatch
 semaphore, ARM endian header, codec glob fix, fstream include)

---
 bell/CMakeLists.txt                           | 11 ++++
 bell/main/io/BellTar.cpp                      |  2 +
 bell/main/platform/WrappedSemaphore.h         |  7 +++
 bell/main/platform/apple/MDNSService.cpp      |  2 +-
 bell/main/platform/apple/WrappedSemaphore.cpp | 51 +++++++++++++++++++
 5 files changed, 72 insertions(+), 1 deletion(-)

diff --git a/bell/CMakeLists.txt b/bell/CMakeLists.txt
index 8631feb..cf54aca 100644
--- a/bell/CMakeLists.txt
+++ b/bell/CMakeLists.txt
@@ -229,6 +229,17 @@ if(NOT BELL_DISABLE_CODECS)
         list(APPEND CODEC_FLAGS -DBELL_CODEC_OPUS)
     endif()
     
+    # armv6-ios3 patch: the glob above pulls in every decoder; drop the ones whose codec is disabled
+    if(NOT BELL_CODEC_OPUS)
+        list(REMOVE_ITEM SOURCES "${AUDIO_CODEC_DIR}/OPUSDecoder.cpp")
+    endif()
+    if(NOT BELL_CODEC_AAC)
+        list(REMOVE_ITEM SOURCES "${AUDIO_CODEC_DIR}/AACDecoder.cpp")
+    endif()
+    if(NOT BELL_CODEC_MP3)
+        list(REMOVE_ITEM SOURCES "${AUDIO_CODEC_DIR}/MP3Decoder.cpp")
+    endif()
+
     # Enable global codecs
     string(REPLACE ";" " " CODEC_FLAGS "${CODEC_FLAGS}")
     set_source_files_properties("${AUDIO_CODEC_DIR}/AudioCodecs.cpp" PROPERTIES COMPILE_FLAGS "${CODEC_FLAGS}")
diff --git a/bell/main/io/BellTar.cpp b/bell/main/io/BellTar.cpp
index aa52bf9..c47cb38 100644
--- a/bell/main/io/BellTar.cpp
+++ b/bell/main/io/BellTar.cpp
@@ -1,5 +1,7 @@
 #include "BellTar.h"
 
+#include <fstream>  // for ofstream (libc++ 18 no longer includes it transitively)
+
 #include <sys/stat.h>  // for mkdir
 
 using namespace bell::BellTar;
diff --git a/bell/main/platform/WrappedSemaphore.h b/bell/main/platform/WrappedSemaphore.h
index e6a5b26..e9cdf9d 100644
--- a/bell/main/platform/WrappedSemaphore.h
+++ b/bell/main/platform/WrappedSemaphore.h
@@ -3,6 +3,9 @@
 #ifdef ESP_PLATFORM
 #include "freertos/FreeRTOS.h"
 #include "freertos/semphr.h"
+#elif defined(__APPLE__) && defined(BELL_APPLE_NO_DISPATCH)
+// iPhone OS < 4 has no libdispatch: pthread mutex + condvar semaphore
+#include <pthread.h>
 #elif __APPLE__
 #include <dispatch/dispatch.h>  // for dispatch_semaphore_t
 #elif _WIN32
@@ -18,6 +21,10 @@ class WrappedSemaphore {
  private:
 #ifdef ESP_PLATFORM
   SemaphoreHandle_t semaphoreHandle;
+#elif defined(__APPLE__) && defined(BELL_APPLE_NO_DISPATCH)
+  pthread_mutex_t mutex;
+  pthread_cond_t cond;
+  int count;
 #elif __APPLE__
   dispatch_semaphore_t semaphoreHandle;
 #elif _WIN32
diff --git a/bell/main/platform/apple/MDNSService.cpp b/bell/main/platform/apple/MDNSService.cpp
index c872f65..519faa9 100644
--- a/bell/main/platform/apple/MDNSService.cpp
+++ b/bell/main/platform/apple/MDNSService.cpp
@@ -4,7 +4,7 @@
 #include <utility>   // for pair
 
 #include "dns_sd.h"       // for DNSServiceRef, DNSServiceRefDeallocate, DNS...
-#include "i386/endian.h"  // for htons
+#include <arpa/inet.h>  // for htons (was i386/endian.h, which does not exist on ARM SDKs)
 
 using namespace bell;
 
diff --git a/bell/main/platform/apple/WrappedSemaphore.cpp b/bell/main/platform/apple/WrappedSemaphore.cpp
index 4fc146f..7566745 100644
--- a/bell/main/platform/apple/WrappedSemaphore.cpp
+++ b/bell/main/platform/apple/WrappedSemaphore.cpp
@@ -2,6 +2,55 @@
 
 using namespace bell;
 
+#ifdef BELL_APPLE_NO_DISPATCH
+// iPhone OS 3 (no libdispatch): counting semaphore on pthread mutex/condvar.
+#include <errno.h>
+#include <sys/time.h>
+
+WrappedSemaphore::WrappedSemaphore(int maxVal) : count(0) {
+  pthread_mutex_init(&mutex, nullptr);
+  pthread_cond_init(&cond, nullptr);
+}
+
+WrappedSemaphore::~WrappedSemaphore() {
+  pthread_cond_destroy(&cond);
+  pthread_mutex_destroy(&mutex);
+}
+
+int WrappedSemaphore::wait() {
+  pthread_mutex_lock(&mutex);
+  while (count == 0)
+    pthread_cond_wait(&cond, &mutex);
+  count--;
+  pthread_mutex_unlock(&mutex);
+  return 0;
+}
+
+int WrappedSemaphore::twait(long milliseconds) {
+  struct timeval now;
+  gettimeofday(&now, nullptr);
+  struct timespec ts;
+  ts.tv_sec = now.tv_sec + milliseconds / 1000;
+  ts.tv_nsec = now.tv_usec * 1000 + (milliseconds % 1000) * 1000000L;
+  if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+  int rc = 0;
+  pthread_mutex_lock(&mutex);
+  while (count == 0 && rc == 0)
+    rc = pthread_cond_timedwait(&cond, &mutex, &ts);
+  if (rc == 0) count--;
+  pthread_mutex_unlock(&mutex);
+  return rc == 0 ? 0 : -1;  // same convention as dispatch_semaphore_wait: non-zero on timeout
+}
+
+void WrappedSemaphore::give() {
+  pthread_mutex_lock(&mutex);
+  count++;
+  pthread_cond_signal(&cond);
+  pthread_mutex_unlock(&mutex);
+}
+
+#else
+
 WrappedSemaphore::WrappedSemaphore(int count) {
   semaphoreHandle = dispatch_semaphore_create(0);
 }
@@ -25,3 +74,5 @@ int WrappedSemaphore::twait(long milliseconds) {
 void WrappedSemaphore::give() {
   dispatch_semaphore_signal(semaphoreHandle);
 }
+
+#endif  // BELL_APPLE_NO_DISPATCH
-- 
2.43.0


From 2f251ceca0116f2526c84b5e3251d12ff493ba1f Mon Sep 17 00:00:00 2001
From: armv6-ios3 <b@b>
Date: Fri, 6 Nov 2026 23:11:28 +0000
Subject: [PATCH 2/4] armv6-ios3: SO_REUSEPORT on Apple listeners, civetweb
 errors into bell log, optional num_threads cap

---
 bell/external/civetweb/civetweb.c | 17 +++++++++++++++++
 bell/main/io/BellHTTPServer.cpp   | 19 ++++++++++++++++++-
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/bell/external/civetweb/civetweb.c b/bell/external/civetweb/civetweb.c
index 5a7cb2d..671876b 100644
--- a/bell/external/civetweb/civetweb.c
+++ b/bell/external/civetweb/civetweb.c
@@ -15935,6 +15935,23 @@ set_ports_option(struct mg_context *phys_ctx)
 			    "cannot set socket option SO_REUSEADDR (entry %i)",
 			    portsTotal);
 		}
+#if defined(__APPLE__) && defined(SO_REUSEPORT)
+		/* armv6-ios3 patch: on XNU a bind() can still be refused while the
+		 * previous instance's accepted connections sit in TIME_WAIT. With
+		 * SO_REUSEPORT on the listener (inherited by accepted sockets) a
+		 * restarted server rebinds immediately. */
+		if (setsockopt(so.sock,
+		               SOL_SOCKET,
+		               SO_REUSEPORT,
+		               (SOCK_OPT_TYPE)&on,
+		               sizeof(on))
+		    != 0) {
+			mg_cry_ctx_internal(
+			    phys_ctx,
+			    "cannot set socket option SO_REUSEPORT (entry %i)",
+			    portsTotal);
+		}
+#endif
 #endif
 
 #if defined(USE_X_DOM_SOCKET)
diff --git a/bell/main/io/BellHTTPServer.cpp b/bell/main/io/BellHTTPServer.cpp
index feb34a5..583a8e4 100644
--- a/bell/main/io/BellHTTPServer.cpp
+++ b/bell/main/io/BellHTTPServer.cpp
@@ -188,6 +188,16 @@ bool BellHTTPServer::handlePost(CivetServer* server,
   }
 }
 
+// armv6-ios3 patch: route civetweb's internal errors (e.g. "cannot bind to 7864: 48
+// (Address already in use)") into the bell log; without a log_message callback and
+// without an error_log_file they are silently dropped and a failed mg_start only
+// surfaces as "CivetException null".
+static int civetLogMessage(const struct mg_connection* conn, const char* message) {
+  (void)conn;
+  BELL_LOG(error, "HttpServer", "civetweb: %s", message);
+  return 1;  // handled, do not also write to civetweb's error log file
+}
+
 BellHTTPServer::BellHTTPServer(int serverPort) {
   std::lock_guard lock(initMutex);
   mg_init_library(0);
@@ -197,7 +207,14 @@ BellHTTPServer::BellHTTPServer(int serverPort) {
 
   civetWebOptions.push_back("listening_ports");
   civetWebOptions.push_back(port);
-  server = std::make_unique<CivetServer>(civetWebOptions);
+#ifdef BELL_HTTP_NUM_THREADS
+  // small devices: civetweb's default is 50 worker threads (50 x 512 KB stacks)
+  civetWebOptions.push_back("num_threads");
+  civetWebOptions.push_back(BELL_HTTP_NUM_THREADS);
+#endif
+  CivetCallbacks callbacks;
+  callbacks.log_message = civetLogMessage;
+  server = std::make_unique<CivetServer>(civetWebOptions, &callbacks);
 }
 
 BellHTTPServer::~BellHTTPServer() {
-- 
