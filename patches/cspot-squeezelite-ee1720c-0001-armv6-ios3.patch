From bb34f6ded4ae08f7a529a649d085f56eb6860d62 Mon Sep 17 00:00:00 2001
From: armv6-ios3 <b@b>
Date: Sat, 7 Nov 2026 03:55:32 +0000
Subject: [PATCH 3/4] armv6-ios3: flush log lines, explicit Task stack sizes
 (BELL_TASK_STACK_FLOOR), fix civetweb USE_STACK_SIZE branch

---
 bell/external/civetweb/civetweb.c        | 13 +++++++++++--
 bell/main/utilities/include/BellLogger.h |  3 +++
 bell/main/utilities/include/BellTask.h   | 19 +++++++++++++++++++
 3 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/bell/external/civetweb/civetweb.c b/bell/external/civetweb/civetweb.c
index 671876b..0236cf3 100644
--- a/bell/external/civetweb/civetweb.c
+++ b/bell/external/civetweb/civetweb.c
@@ -5891,10 +5891,19 @@ mg_start_thread_with_id(mg_thread_func_t func,
 #elif defined(USE_STACK_SIZE) && (USE_STACK_SIZE > 1)
 	/* Compile-time option to control stack size,
 	 * e.g. -DUSE_STACK_SIZE=16384 */
-	(void)pthread_attr_setstacksize(&attr, USE_STACK_SIZE);
+	/* armv6-ios3 patch: this branch referenced an undeclared `attr` (the
+	 * squeezelite fork dropped the attr setup when adding the ESP path). */
+	{
+		pthread_attr_t attr;
+		(void)pthread_attr_init(&attr);
+		(void)pthread_attr_setstacksize(&attr, USE_STACK_SIZE);
+		result = pthread_create(&thread_id, &attr, func, param);
+		(void)pthread_attr_destroy(&attr);
+	}
+#else
+	result = pthread_create(&thread_id, NULL, func, param);
 #endif /* defined(USE_STACK_SIZE) && USE_STACK_SIZE > 1 */
 
-	result = pthread_create(&thread_id, NULL, func, param);
 	if ((result == 0) && (threadidptr != NULL)) {
 		*threadidptr = thread_id;
 	}
diff --git a/bell/main/utilities/include/BellLogger.h b/bell/main/utilities/include/BellLogger.h
index 7e33688..30ea14f 100644
--- a/bell/main/utilities/include/BellLogger.h
+++ b/bell/main/utilities/include/BellLogger.h
@@ -45,6 +45,7 @@ class BellLogger : public bell::AbstractLogger {
     vprintf(format, args);
     va_end(args);
     printf("\n");
+    fflush(stdout);  // armv6-ios3 patch: a line must survive a reboot when stdout is a pipe/file
   };
 
   void error(std::string filename, int line, std::string submodule,
@@ -65,6 +66,7 @@ class BellLogger : public bell::AbstractLogger {
     vprintf(format, args);
     va_end(args);
     printf("\n");
+    fflush(stdout);  // armv6-ios3 patch: a line must survive a reboot when stdout is a pipe/file
   };
 
   void info(std::string filename, int line, std::string submodule,
@@ -85,6 +87,7 @@ class BellLogger : public bell::AbstractLogger {
     vprintf(format, args);
     va_end(args);
     printf("\n");
+    fflush(stdout);  // armv6-ios3 patch: a line must survive a reboot when stdout is a pipe/file
   };
 
   void printTimestamp() {
diff --git a/bell/main/utilities/include/BellTask.h b/bell/main/utilities/include/BellTask.h
index 0607399..852ebca 100644
--- a/bell/main/utilities/include/BellTask.h
+++ b/bell/main/utilities/include/BellTask.h
@@ -65,6 +65,25 @@ class Task {
     thread = CreateThread(NULL, stackSize,
                           (LPTHREAD_START_ROUTINE)taskEntryFunc, this, 0, NULL);
     return thread != NULL;
+#elif defined(BELL_TASK_STACK_FLOOR)
+    // armv6-ios3 patch: explicit stack sizes instead of Darwin's 512 KB default.
+    // stackSize is the ESP32 figure (1-48 KB), far too small for a desktop libc;
+    // use max(BELL_TASK_STACK_FLOOR, 4 * stackSize), capped at 512 KB.
+    {
+      size_t sz = (size_t)stackSize * 4;
+      if (sz < (size_t)BELL_TASK_STACK_FLOOR) sz = BELL_TASK_STACK_FLOOR;
+      if (sz > 512 * 1024) sz = 512 * 1024;
+      pthread_attr_t attr;
+      pthread_attr_init(&attr);
+      pthread_attr_setstacksize(&attr, sz);
+      int rc = pthread_create(&thread, &attr, taskEntryFunc, this);
+      pthread_attr_destroy(&attr);
+      if (!rc) {
+        pthread_detach(thread);
+        return true;
+      }
+      return false;
+    }
 #else
     if (!pthread_create(&thread, NULL, taskEntryFunc, this)) {
         pthread_detach(thread);
-- 
