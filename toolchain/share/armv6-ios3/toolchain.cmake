# CMake toolchain file for ARMv6 iPhone OS 3.x (use with IOS3_SDK set in the environment)
#   cmake -DCMAKE_TOOLCHAIN_FILE=<toolchain>/share/armv6-ios3/toolchain.cmake ...
get_filename_component(_IOS3_TC "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED ENV{IOS3_SDK})
  message(FATAL_ERROR "set IOS3_SDK to the iPhoneOS3.1.2.sdk directory")
endif()
set(CMAKE_SYSTEM_NAME Darwin)            # Darwin (not iOS) keeps CMake from adding Xcode-only logic
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR armv6)
set(CMAKE_C_COMPILER   "${_IOS3_TC}/bin/armv6-ios3-clang")
set(CMAKE_CXX_COMPILER "${_IOS3_TC}/bin/armv6-ios3-clang++")
set(CMAKE_OBJC_COMPILER "${_IOS3_TC}/bin/armv6-ios3-clang")
set(CMAKE_ASM_COMPILER "${_IOS3_TC}/bin/armv6-ios3-clang")
set(CMAKE_AR      "${_IOS3_TC}/bin/armv6-ios3-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB  "${_IOS3_TC}/bin/armv6-ios3-ranlib" CACHE FILEPATH "")
set(CMAKE_LINKER  "${_IOS3_TC}/bin/armv6-ios3-ld" CACHE FILEPATH "")
set(CMAKE_NM      "${_IOS3_TC}/bin/armv6-ios3-nm" CACHE FILEPATH "")
set(CMAKE_STRIP   "${_IOS3_TC}/bin/armv6-ios3-strip" CACHE FILEPATH "")
set(CMAKE_OTOOL   "${_IOS3_TC}/bin/armv6-ios3-otool" CACHE FILEPATH "")
set(CMAKE_INSTALL_NAME_TOOL "${_IOS3_TC}/bin/armv6-ios3-install_name_tool" CACHE FILEPATH "")
set(CMAKE_OSX_SYSROOT "" CACHE PATH "")        # the wrappers pass -isysroot themselves
set(CMAKE_OSX_ARCHITECTURES "" CACHE STRING "")
set(CMAKE_OSX_DEPLOYMENT_TARGET "" CACHE STRING "")
set(CMAKE_FIND_ROOT_PATH "$ENV{IOS3_SDK}" "${_IOS3_TC}/armv6-ios3")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(APPLE 1)
set(IOS3 1)
